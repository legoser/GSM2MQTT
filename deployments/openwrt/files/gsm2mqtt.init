#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

PROG=/usr/bin/gsm2mqtt
DEFAULT_CONF=/etc/gsm2mqtt/gsm2mqtt.yaml

start_service() {
    config_load "gsm2mqtt" 2>/dev/null
    local enabled
    config_get_bool enabled "config" "enabled" 1
    [ "$enabled" -eq 1 ] || return 0

    local config_file
    config_get config_file "config" "config_file" "$DEFAULT_CONF"

    [ -f "$config_file" ] || {
        echo "gsm2mqtt: configuration file $config_file not found" >&2
        return 1
    }

    # Ensure runtime directories exist
    mkdir -p /var/run/gsm2mqtt

    procd_open_instance "gsm2mqtt"
    procd_set_param command "$PROG" --config "$config_file"
    procd_set_param env GOMEMLIMIT="10MiB" GOGC="25" GODEBUG="madvdontneed=1"
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file "$config_file"
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger "gsm2mqtt"
}

reload_service() {
    stop
    start
}
