# ============================================================
# GSM2MQTT Docker Environment Variables
# ============================================================

# Path to the serial modem device on the host
# Examples:
#   /dev/ttyUSB0  (USB-to-Serial dongle, SIM800L, Siemens)
#   /dev/ttyACM0  (Quectel, internal USB ACM)
#   /dev/serial/by-id/usb-HUAWEI_MOBILE-if00-port0
MODEM_DEVICE=/dev/ttyUSB0

# Emulate virtual GSM modem inside Docker for testing without physical hardware (true/false)
MOCK_MODEM=false

# Web Dashboard and REST API port on the host
API_PORT=8080

# MQTT broker port on the host
MQTT_PORT=1883

