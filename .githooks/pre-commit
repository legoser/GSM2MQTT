#!/usr/bin/env bash
set -e

# 1. Format changed Go files
CHANGED_GO_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.go$' || true)
if [ -n "$CHANGED_GO_FILES" ]; then
    echo "=> [pre-commit] Checking Go formatting..."
    for file in $CHANGED_GO_FILES; do
        if [ -f "$file" ]; then
            gofmt -s -w "$file"
            git add "$file"
        fi
    done
fi

# 2. Run static analysis
echo "=> [pre-commit] Running go vet..."
go vet ./...

# 3. Run unit tests
echo "=> [pre-commit] Running test suite..."
go test -count=1 ./...

echo "=> [pre-commit] All pre-commit checks passed!"
